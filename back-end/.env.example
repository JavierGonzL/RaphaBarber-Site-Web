# Variables de entorno — RaphaBarber back-end
# Copia este archivo como .env y rellena los valores reales
# NUNCA commitear .env al repositorio

# Base de datos (Postgres local vía Docker en Fase 0)
DATABASE_URL="postgresql://raphabarber:raphabarber@localhost:5432/raphabarber?schema=public"

# Puerto del servidor Fastify
PORT=4000

# Origen permitido para CORS (el front-end en desarrollo)
FRONTEND_ORIGIN="http://localhost:3000"

# Firma de tokens de administrador (Fase 4) — genera uno propio, no reuses este
JWT_SECRET="reemplaza-con-una-cadena-aleatoria-larga"

# Usados solo por `npm run admin:create` para dar de alta la cuenta de admin
ADMIN_EMAIL="admin@raphabarber.local"
ADMIN_PASSWORD="cambia-esta-clave"

# Cifrado del refresh token de Google (Fase 7) — genera uno propio, no reuses este
ENCRYPTION_KEY="reemplaza-con-64-caracteres-hexadecimales"

# Credenciales OAuth de Google Cloud Console (Fase 7)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/auth/google/callback"

# Mercado Pago (Fase 11) — usa credenciales de PRUEBA mientras desarrollas
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
MP_DEPOSITO_MONTO=150
# URL pública (ngrok mientras estemos en local) + /webhooks/mercadopago
MP_NOTIFICATION_URL=""
